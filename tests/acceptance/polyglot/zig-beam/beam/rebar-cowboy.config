%% Harness overlay for the Cowboy checkout. Upstream builds with erlang.mk,
%% which compiles test/ recursively. rebar3's test profile only adds test/
%% itself, so the handler modules under test/handlers are absent. This file
%% supplies the missing source directory without editing upstream tests.
{deps, [
    {cowlib, ".*", {git, "https://github.com/ninenines/cowlib", {tag, "2.21.0"}}},
    {ranch, ".*", {git, "https://github.com/ninenines/ranch", {tag, "1.8.1"}}}
]}.
{erl_opts, [debug_info, warn_export_vars, warn_shadow_vars, warn_obsolete_guard,
            warn_missing_spec, warn_untyped_record]}.
{profiles, [
    {test, [
        {src_dirs, ["src", "test", "test/handlers"]}
    ]}
]}.
